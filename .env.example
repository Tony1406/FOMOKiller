################################################################################
#  FOMOKiller - Configuracion de entorno
#
#  1. Copia este fichero a .env:    cp .env.example .env
#  2. Cambia SOLO los valores marcados con CAMBIAR.
#  3. Levanta el stack:              docker compose up -d --build
#
#  IMPORTANTE: el .env nunca se sube al repo (ya esta en .gitignore).
################################################################################


# ==============================================================================
# Base de datos (MySQL 8)
# ==============================================================================

# Contrasena del usuario root de MySQL. Solo se usa internamente.
MYSQL_ROOT_PASSWORD=CAMBIAR_root_password_largo_y_aleatorio

# Nombre de la base. No hace falta tocar.
MYSQL_DATABASE=fomokiller

# Usuario aplicativo que usa el server para conectarse a la base.
MYSQL_USER=fkuser

# Contrasena del usuario aplicativo.
MYSQL_PASSWORD=CAMBIAR_password_largo_y_aleatorio


# ==============================================================================
# Backend (Node + Express)
# ==============================================================================

# Secreto para firmar tokens JWT. CAMBIALO siempre.
# Genera uno con: openssl rand -hex 32
JWT_SECRET=CAMBIAR_genera_uno_con_openssl_rand_hex_32

# Origen(es) permitido(s) por CORS. Acepta varios separados por coma.
#   - Local sin docker:  http://localhost:5173
#   - Local con prod:    http://localhost:8080
#   - Servidor casero:   https://fomokiller.tudominio.com
CLIENT_URL=https://CAMBIAR.tudominio.com

# APIs externas (opcionales: si las dejas vacias, las features dependientes no van).
RAWG_API_KEY=
YOUTUBE_API_KEY=

# Cloudinary para subida de avatares (opcional).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ==============================================================================
# Frontend (nginx sirviendo el bundle de Vite)
# ==============================================================================

# Puerto del host donde escucha el nginx del cliente.
CLIENT_PORT=8080

# Interfaz del host a la que se bindea CLIENT_PORT.
#   - Vacio:        escucha en todas las interfaces (0.0.0.0). Util en local.
#   - 127.0.0.1:    solo accesible desde el propio host. RECOMENDADO en
#                   produccion cuando hay un nginx reverse proxy delante.
HOST_BIND=127.0.0.1

# URL del API que se hornea en el bundle del cliente en tiempo de build.
# Dejar /api hace que el cliente llame a su propio dominio y el nginx interno
# proxifique al server. No tocar salvo que sepas lo que haces.
VITE_API_URL=/api


# ==============================================================================
# Solo para modo desarrollo (docker-compose.dev.yml)
# ==============================================================================

# Puerto del host hacia MySQL en dev.
DB_PORT_HOST=3307

# Puerto del host donde escucha el vite dev server en dev.
CLIENT_DEV_PORT=5173
